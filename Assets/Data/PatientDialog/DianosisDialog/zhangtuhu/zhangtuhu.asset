  lines:
  - name: "\u5F20\u5C60\u6237"
    text: "\u5927\u592B\uFF0C\u6211\u5FC3\u91CC\u8FD9\u56E2\u706B\u70E7\u5F97\u6211\u96BE\u53D7\uFF01"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 073744af8c02d8b4f9a7054e865ed411, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: ' '
    text: "\u5F20\u5C60\u6237\u4E00\u62CD\u684C\u5B50\uFF0C\u628A\u8109\u6795\u90FD\u9707\u6B6A\u4E86\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 073744af8c02d8b4f9a7054e865ed411, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u6211\u8FD9\u4E24\u5929\u5934\u75BC\u5F97\u8981\u88C2\u5F00\uFF0C\u773C\u775B\u7EA2\u5F97\u50CF\u5154\u5B50\uFF0C\u665A\u4E0A\u7FFB\u6765\u8986\u53BB\u7761\u4E0D\u7740\uFF01"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 073744af8c02d8b4f9a7054e865ed411, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u9694\u58C1\u738B\u4E8C\u90A3\u53AE\uFF0C\u5356\u8089\u6BD4\u4FFA\u4FBF\u5B9C\u4E24\u6587\uFF01\u6211\u5BB6\u4E09\u4EE3\u5BB0\u732A\uFF0C\u5230\u4ED6\u8FD9\u513F\u6210\u4E86\u9ED1\u5FC3\u5546\uFF1F"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 073744af8c02d8b4f9a7054e865ed411, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u6628\u5929\u6709\u4E2A\u8001\u4E3B\u987E\u6765\u4E70\u8089\uFF0C\u6211\u5DEE\u70B9\u628A\u4EBA\u8F70\u51FA\u53BB\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 073744af8c02d8b4f9a7054e865ed411, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u6211\u8001\u5A46\u8BF4\u6211\u53D8\u4E86\u3002\u53EF\u6211\u5C31\u662F\u538B\u4E0D\u4F4F\u8FD9\u706B\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 073744af8c02d8b4f9a7054e865ed411, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u5927\u592B\u60A8\u7ED9\u770B\u770B\uFF0C\u6211\u8FD9\u662F\u4E0D\u662F\u4E2D\u4E86\u90AA\uFF1F"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 073744af8c02d8b4f9a7054e865ed411, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
