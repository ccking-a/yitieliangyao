  lines:
  - name: 
    text: "\u4E00\u4F4D\u4F4E\u5934\u62ED\u6CEA\u7684\u5973\u5B50\uFF0C\u80A9\u8180\u5FAE\u5FAE\u98A4\u6296\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 062a8c970883bbe46aaeda24a2703f61, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u67F3\u5A18\u5B50"
    text: "\u5927\u592B\uFF0C\u6211\u60F3\u6211\u592B\u541B\u2026\u2026"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 062a8c970883bbe46aaeda24a2703f61, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u67F3\u5A18\u5B50"
    text: "\u592B\u541B\u4E00\u5E74\u524D\u53BB\u8FB9\u5173\u4ECE\u519B\u4E86\u3002\u6773\u65E0\u97F3\u4FE1\uFF0C\u6211\u5929\u5929\u54ED\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 062a8c970883bbe46aaeda24a2703f61, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u67F3\u5A18\u5B50"
    text: "\u6700\u8FD1\u4E00\u76F4\u5E72\u54B3\uFF0C\u505C\u4E0D\u4E0B\u6765\u3002\u6C14\u4E0D\u591F\u7528\uFF0C\u8BF4\u8BDD\u90FD\u6CA1\u529B\u6C14\u3002\u80F8\u95F7\u5F97\u614C\uFF0C\u50CF\u538B\u4E86\u5757\u77F3\u5934\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 062a8c970883bbe46aaeda24a2703f61, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u67F3\u5A18\u5B50"
    text: "\u665A\u4E0A\u54B3\u5F97\u66F4\u51F6\uFF0C\u7761\u4E0D\u7740\u3002\u7EE3\u6D3B\u4E5F\u505A\u4E0D\u4E0B\u53BB\u4E86\u3002\u770B\u4EC0\u4E48\u90FD\u60F3\u54ED\uFF0C\u5FCD\u4E0D\u4F4F\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 062a8c970883bbe46aaeda24a2703f61, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u67F3\u5A18\u5B50"
    text: "\u55D3\u5B50\u5E72\u75BC\uFF0C\u559D\u6C34\u4E5F\u4E0D\u7BA1\u7528\u3002\u5927\u592B\uFF0C\u53EF\u6709\u4EC0\u4E48\u529E\u6CD5\uFF1F"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 062a8c970883bbe46aaeda24a2703f61, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: 
    text: "\u5E08\u5085\u66FE\u8BF4\uFF0C\u60B2\u5FE7\u4F24\u80BA\uFF0C\u80BA\u6C14\u8017\u4F24\u3002\u5F53\u8865\u80BA\u76CA\u6C14\uFF0C\u517C\u4EE5\u89E3\u90C1\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 0}
    typingCharsPerSecond: 30
    autoNextDelay: 3
