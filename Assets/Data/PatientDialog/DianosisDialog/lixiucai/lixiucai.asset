  - name: "\u674E\u79C0\u624D"
    text: "\u6700\u8FD1\u8336\u996D\u4E0D\u601D\uFF0C\u5403\u4E0D\u4E0B\u4E1C\u897F\u3002\u809A\u5B50\u603B\u662F\u80C0\u80C0\u7684\uFF0C\u4E0D\u6D88\u5316\u3002\u5403\u4EC0\u4E48\u90FD\u6CA1\u6ECB\u5473\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: fb38a51371e987040a9d849b7864f0f2, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u674E\u79C0\u624D"
    text: "\u6D51\u8EAB\u6CA1\u529B\u6C14\uFF0C\u8D70\u51E0\u6B65\u5C31\u5598\u3002\u8BB0\u6027\u8D8A\u6765\u8D8A\u5DEE\uFF0C\u4E66\u80CC\u4E0D\u4F4F\u3002\u591C\u91CC\u7FFB\u6765\u8986\u53BB\u7761\u4E0D\u7740\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: fb38a51371e987040a9d849b7864f0f2, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u674E\u79C0\u624D"
    text: "\u5927\u4FBF\u7A00\u6E8F\uFF0C\u4E00\u5929\u597D\u51E0\u56DE\u3002\u9762\u8272\u8721\u9EC4\uFF0C\u7167\u955C\u5B50\u90FD\u6015\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: fb38a51371e987040a9d849b7864f0f2, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u674E\u79C0\u624D"
    text: "\u5927\u592B\uFF0C\u6211\u8FD8\u80FD\u8003\u4E0A\u5417\uFF1F"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: fb38a51371e987040a9d849b7864f0f2, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: 
    text: "\u5E08\u5085\u66FE\u8BF4\u8FC7\uFF0C\u601D\u8651\u8FC7\u5EA6\uFF0C\u635F\u4F24\u813E\u80C3\u3002\u5F53\u5065\u813E\u76CA\u6C14\uFF0C\u4F50\u4EE5\u5B89\u795E\u3002"
