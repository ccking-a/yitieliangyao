  m_Name: wangbutou
  m_EditorClassIdentifier: 
  lines:
  - name: 
    text: "\u4E00\u4F4D\u6355\u5934\u5DE6\u987E\u53F3\u76FC\uFF0C\u624B\u59CB\u7EC8\u6309\u7740\u5200\u67C4\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: c2d746c310681d34698bd036b8251838, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u738B\u6355\u5934"
    text: "\u5927\u592B\u2026\u2026\u90A3\u665A\u7684\u4E8B\u6211\u5FD8\u4E0D\u6389\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: c2d746c310681d34698bd036b8251838, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u738B\u6355\u5934"
    text: "\u4E0A\u6708\u8FFD\u4E00\u4E2A\u608D\u532A\uFF0C\u5728\u5C71\u91CC\u57CB\u4F0F\u3002\u90A3\u532A\u5F92\u7A81\u7136\u66B4\u8D77\uFF0C\u4E00\u5200\u780D\u5411\u8001\u674E\u3002\u8001\u674E\u7684\u8840\u6E85\u4E86\u6211\u4E00\u8138\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: c2d746c310681d34698bd036b8251838, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u738B\u6355\u5934"
    text: "\u867D\u7136\u540E\u6765\u628A\u4EBA\u6293\u4E86\uFF0C\u4F46\u6211\u2026\u2026\u6BCF\u665A\u95ED\u773C\u5C31\u662F\u90A3\u4E2A\u753B\u9762\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: c2d746c310681d34698bd036b8251838, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u738B\u6355\u5934"
    text: "\u7761\u89C9\u51FA\u51B7\u6C57\uFF0C\u88AB\u5B50\u90FD\u662F\u6E7F\u7684\u3002\u8170\u9178\u817F\u8F6F\uFF0C\u5200\u90FD\u63D0\u4E0D\u52A8\u4E86\u3002\u8001\u60F3\u4E0A\u5395\u6240\uFF0C\u618B\u4E0D\u4F4F\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: c2d746c310681d34698bd036b8251838, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u738B\u6355\u5934"
    text: "\u542C\u5230\u54CD\u58F0\u5C31\u5FC3\u8DF3\u52A0\u901F\u3002\u6211\u8FD9\u8F88\u5B50\u6CA1\u8FD9\u4E48\u6015\u8FC7\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: c2d746c310681d34698bd036b8251838, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: 
    text: "\u5E08\u5085\u66FE\u8BF4\uFF0C\u6050\u5219\u4F24\u80BE\uFF0C\u80BE\u6C14\u4E0D\u56FA\u3002\u5F53\u8865\u80BE\u586B\u7CBE\uFF0C\u9547\u60CA\u5B89\u795E\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 0}
    typingCharsPerSecond: 30
    autoNextDelay: 3
