  lines:
  - name: 
    text: "\u94B1\u5A92\u5A46\u63A5\u8FC7\u836F\u7897\uFF0C\u6DF1\u6DF1\u5438\u4E86\u4E00\u53E3\u6C14\uFF0C\u773C\u775B\u5FAE\u5FAE\u53D1\u4EAE"
