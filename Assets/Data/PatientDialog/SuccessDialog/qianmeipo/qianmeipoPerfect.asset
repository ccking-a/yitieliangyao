    expressionSprite: {fileID: 21300000, guid: 98b4a1b0cd4297a489446f540d281c17, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u94B1\u5A92\u5A46"
    text: "\u54CE\u5440\uFF0C\u8FD9\u836F\u95FB\u7740\u5C31\u8BA9\u4EBA\u5FC3\u91CC\u8E0F\u5B9E\uFF01"
