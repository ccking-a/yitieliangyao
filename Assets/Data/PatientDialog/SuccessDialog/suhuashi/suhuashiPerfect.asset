  m_Name: suhuashiPerfect
  m_EditorClassIdentifier: 
  lines:
  - name: 
    text: "\u82CF\u753B\u5E08\u63A5\u8FC7\u836F\u7897\uFF0C\u76EF\u7740\u7897\u91CC\u770B\u4E86\u5F88\u4E45\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 549e10d7699b1644bbe16e76bf9a0e36, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u82CF\u753B\u5E08"
    text: "\u60A8\u521A\u624D\u6363\u836F\u7684\u58F0\u97F3\uFF0C\u4E00\u4E0B\u4E00\u4E0B\u7684\uFF0C\u7279\u522B\u7A33\u3002\u6211\u8111\u5B50\u91CC\u90A3\u4E24\u4E2A\u5435\u67B6\u7684\u58F0\u97F3\uFF0C\u597D\u50CF\u7A81\u7136\u5B89\u9759\u4E86\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 549e10d7699b1644bbe16e76bf9a0e36, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: 
    text: "\u4ED6\u6162\u6162\u559D\u4E0B\uFF0C\u773C\u7736\u6709\u70B9\u7EA2\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 549e10d7699b1644bbe16e76bf9a0e36, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u82CF\u753B\u5E08"
    text: "\u597D\u51E0\u5E74\u6CA1\u8FD9\u4E48\u8E0F\u5B9E\u8FC7\u4E86\u3002\u539F\u6765\u4E0D\u662F\u6211\u753B\u4E0D\u597D\uFF0C\u662F\u6211\u4ECE\u6765\u6CA1\u76F8\u4FE1\u8FC7\u81EA\u5DF1\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 549e10d7699b1644bbe16e76bf9a0e36, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u82CF\u753B\u5E08"
    text: "\u90A3\u4E2A\u7B97\u6CD5\u753B\u5F97\u518D\u5FEB\uFF0C\u753B\u4E0D\u51FA\u6211\u6628\u5929\u770B\u5230\u7684\u90A3\u573A\u843D\u65E5\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 549e10d7699b1644bbe16e76bf9a0e36, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u82CF\u753B\u5E08"
    text: "\u60A8\u8BA9\u6211\u60F3\u660E\u767D\u4E86\u2014\u2014\u5FEB\u7684\u753B\u662F\u753B\uFF0C\u6162\u7684\u753B\u4E5F\u662F\u753B\u3002\u6211\u8981\u753B\u6211\u81EA\u5DF1\u60F3\u753B\u7684\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 549e10d7699b1644bbe16e76bf9a0e36, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
