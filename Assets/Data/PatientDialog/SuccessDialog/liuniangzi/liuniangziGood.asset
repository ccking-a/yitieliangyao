  - name: "\u67F3\u5A18\u5B50"
    text: "\u8C22\u8C22\u5927\u592B\u2026\u2026\u6BD4\u524D\u4E9B\u5929\u5F3A\u4E9B\u3002\u5C31\u662F\u90A3\u80A1\u52B2\u513F\u4E0D\u592A\u5300\uFF0C\u6709\u65F6\u5019\u987A\uFF0C\u6709\u65F6\u5019\u5835\u3002"
