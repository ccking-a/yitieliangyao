  - name: "\u67F3\u5A18\u5B50"
    text: "\u5927\u592B\u2026\u2026\u60A8\u521A\u624D\u6363\u836F\u7684\u58F0\u97F3\u5FFD\u5927\u5FFD\u5C0F\uFF0C\u6211\u542C\u7740\u5FC3\u614C\u3002"
