    expressionSprite: {fileID: 21300000, guid: 6295a879ac712ba40b10f62eaed6bdbd, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: 
    text: "\u4ED6\u559D\u5B8C\u836F\uFF0C\u7838\u4E86\u5482\u5634"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 6295a879ac712ba40b10f62eaed6bdbd, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u8FD8\u884C\uFF0C\u559D\u4E86\u4E4B\u540E\u5934\u75BC\u786E\u5B9E\u8F7B\u4E86\u4E9B\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 6295a879ac712ba40b10f62eaed6bdbd, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u5C31\u662F\u2026\u2026\u600E\u4E48\u8BF4\u5462\uFF0C\u611F\u89C9\u8FD9\u836F\u91CC\u6709\u70B9\u2018\u6BDB\u8E81\u2019\uFF0C\u8DDF\u6211\u813E\u6C14\u4F3C\u7684\u3002\u4E0B\u6B21\u6363\u836F\u7A33\u5F53\u70B9\uFF0C\u6211\u4E5F\u8DDF\u7740\u5FC3\u9759\u3002"
