    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u5927\u592B\uFF0C\u836F\u662F\u597D\u836F\uFF0C\u4E0D\u8FC7\u6211\u521A\u624D\u770B\u4F60\u6363\u836F\u7684\u65F6\u5019\uFF0C\u4E2D\u95F4\u6709\u51E0\u4E0B\u4E71\u4E86\u8282\u594F\uFF0C\u6211\u8FD9\u5FC3\u4E5F\u8DDF\u7740\u63EA\u4E86\u4E00\u4E0B\u3002"
