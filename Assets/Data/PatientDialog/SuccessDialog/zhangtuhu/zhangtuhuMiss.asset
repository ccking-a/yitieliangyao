  lines:
  - name: 
    text: "\u5F20\u5C60\u6237\u76B1\u7740\u7709\u63A5\u8FC7\u836F\u7897\uFF0C\u8138\u8272\u66F4\u96BE\u770B\u4E86"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: ec27f4d3023ff46499dc5ae2dfd0e3ac, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u5927\u592B\uFF01\u4F60\u521A\u624D\u6363\u836F\u53EE\u53EE\u54A3\u54A3\u7684\uFF0C\u542C\u5F97\u6211\u706B\u5192\u4E09\u4E08\uFF01\u6211\u8FD8\u4EE5\u4E3A\u4F60\u5728\u7838\u6211\u5BB6\u9505\u5462\uFF01"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: ec27f4d3023ff46499dc5ae2dfd0e3ac, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: 
    text: "\u4ED6\u52C9\u5F3A\u559D\u5B8C\uFF0C\u62B9\u4E86\u62B9\u5634\uFF0C\u8BED\u6C14\u4E0D\u6EE1"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: ec27f4d3023ff46499dc5ae2dfd0e3ac, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u8FD9\u836F\u559D\u7740\u2026\u2026\u4E00\u80A1\u5B50\u6025\u8E81\u5473\u513F\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: ec27f4d3023ff46499dc5ae2dfd0e3ac, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u672C\u6765\u6211\u8FDB\u6765\u8FD8\u60F3\u597D\u597D\u8C22\u4F60\uFF0C\u73B0\u5728\u53C8\u618B\u4E00\u809A\u5B50\u6C14\u4E86\u3002\u4E0B\u6B21\u4F60\u518D\u8FD9\u4E48\u6363\u836F\uFF0C\u6211\u8FD9\u809D\u706B\u6015\u662F\u964D\u4E0D\u4E0B\u53BB\uFF01"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: ec27f4d3023ff46499dc5ae2dfd0e3ac, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
