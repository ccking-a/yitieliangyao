  lines:
  - name: "\u5F20\u5C60\u6237"
    text: "\uFF08\u7709\u5934\u7F13\u7F13\u677E\u5F00\uFF0C\u58F0\u97F3\u4F4E\u6C89\u800C\u8BDA\u6073\uFF09\u201C\u5927\u592B\u2026\u2026\u8FD9\u836F\u95FB\u7740\u5C31\u8212\u5766\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 6295a879ac712ba40b10f62eaed6bdbd, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u6211\u8FDB\u95E8\u524D\u8FD8\u618B\u7740\u4E00\u809A\u5B50\u706B\uFF0C\u521A\u624D\u770B\u4F60\u6363\u836F\uFF0C\u90A3\u8282\u594F\u4E00\u4E0B\u4E00\u4E0B\u7684\uFF0C\u6211\u542C\u7740\u542C\u7740\u2026\u2026\u80F8\u53E3\u90A3\u5757\u5835\u7740\u7684\u77F3\u5934\uFF0C\u597D\u50CF\u6162\u6162\u788E\u4E86\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 6295a879ac712ba40b10f62eaed6bdbd, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: 
    text: "\u4ED6\u7AEF\u8D77\u836F\u7897\u4E00\u996E\u800C\u5C3D\uFF0C\u957F\u51FA\u4E00\u53E3\u6C14\uFF1A"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 6295a879ac712ba40b10f62eaed6bdbd, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u75DB\u5FEB\uFF01\u8FD9\u836F\u559D\u4E0B\u53BB\uFF0C\u4E0D\u50CF\u4EE5\u524D\u5403\u90A3\u4E9B\u82E6\u836F\u8BA9\u4EBA\u66F4\u70E6\u8E81\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 6295a879ac712ba40b10f62eaed6bdbd, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5F20\u5C60\u6237"
    text: "\u53CD\u800C\u2026\u2026\u600E\u4E48\u8BF4\u5462\uFF0C\u50CF\u6709\u4EBA\u62CD\u7740\u6211\u540E\u80CC\u8BF4\u2018\u6D88\u6D88\u6C14\u2019\u4E00\u6837\u3002\u5F20\u5C60\u6237\u8FD9\u6761\u547D\uFF0C\u662F\u4F60\u6551\u7684\uFF01"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 6295a879ac712ba40b10f62eaed6bdbd, type: 3}
