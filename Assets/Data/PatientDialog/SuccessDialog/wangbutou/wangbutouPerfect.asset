  lines:
  - name: 
    text: "\u738B\u6355\u5934\u63A5\u8FC7\u836F\u7897\uFF0C\u76EF\u7740\u7897\u6CBF\u6C89\u9ED8\u4E86\u51E0\u79D2\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: c288f8a77fefd024280889c350c9fadb, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u738B\u6355\u5934"
    text: "\u8FD9\u836F\u6363\u5F97\u7A33\u3002\u6BCF\u4E00\u4E0B\u90FD\u624E\u624E\u5B9E\u5B9E\u7684\uFF0C\u50CF\u6709\u4EBA\u7AD9\u5728\u8EAB\u540E\u6491\u7740\u6211\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: c288f8a77fefd024280889c350c9fadb, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: 
    text: "\u4ED6\u4E00\u53E3\u6C14\u559D\u5B8C\uFF0C\u957F\u51FA\u4E00\u53E3\u6C14"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: c288f8a77fefd024280889c350c9fadb, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u738B\u6355\u5934"
    text: "\u542C\u60A8\u6363\u836F\u7684\u8282\u594F\uFF0C\u6211\u8FD9\u5FC3\u8DF3\u6162\u6162\u5C31\u4E0B\u6765\u4E86\u3002\u597D\u51E0\u5929\u6CA1\u8FD9\u4E48\u8E0F\u5B9E\u4E86\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: c288f8a77fefd024280889c350c9fadb, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u738B\u6355\u5934"
    text: "\u5FC3\u91CC\u8E0F\u5B9E\u4E86\u3002\u90A3\u665A\u7684\u4E8B\u8FD8\u5728\uFF0C\u4F46\u4E0D\u90A3\u4E48\u6015\u4E86\u3002\u8FC7\u4E24\u65E5\u6211\u628A\u8170\u724C\u6302\u4EF6\u7ED9\u60A8\u9001\u6765\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: c288f8a77fefd024280889c350c9fadb, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
