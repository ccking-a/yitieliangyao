  gift:
    patient: {fileID: 11400000}
    name: "\u82CF\u753B\u5E08"
    description: "\u82CF\u753B\u5E08\u8BF4\u8FD9\u662F\u4ED6\u7ED3\u4E1A\u540E\u753B\u7684\u7B2C\u4E00\u5F20\u6247\u9762\uFF0C\u753B\u7684\u662F\u533B\u9986\u95E8\u53E3\u7684\u90A3\u68F5\u8001\u69D0\u6811\u3002\u4ED6\u8BF4\u4E09\u4E2A\u6708\u524D\u8D70\u8FDB\u6765\u7684\u65F6\u5019\uFF0C\u4EC0\u4E48\u90FD\u6CA1\u770B\u89C1\uFF1B\u73B0\u5728\u8D70\u51FA\u53BB\uFF0C\u4EC0\u4E48\u90FD\u60F3\u753B\u3002\u5E0C\u671B\u4F60\u4E5F\u770B\u89C1\u8EAB\u8FB9\u7684\u597D\u98CE\u666F\u3002"
