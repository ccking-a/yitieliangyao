    thankYouLines:
    - name: "\u82CF\u753B\u5E08"
      text: "\u5927\u592B\uFF01\u753B\u9662\u7ED3\u4E1A\u4E86\uFF0C\u6211\u7684\u300A\u8001\u69D0\u6811\u300B\u88AB\u9009\u5165\u85CF\u753B\u9601\u3002\u4E09\u4E2A\u6708\u524D\u6211\u5DEE\u70B9\u6254\u6389\u753B\u7B14\uFF0C\u73B0\u5728\u4E0D\u6015\u4E86\u3002\u7B97\u6CD5\u753B\u518D\u5FEB\uFF0C\u753B\u4E0D\u51FA\u90A3\u68F5\u6811\u7684\u5F71\u5B50\u3002\u8FD9\u662F\u6211\u8FDE\u591C\u753B\u7684\u6247\u9762\uFF0C\u9001\u60A8\u3002"
