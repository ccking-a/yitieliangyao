  lines:
  - name: "\u5E08\u5085"
    text: "\u6363\u836F\u53EF\u4E0D\u53EA\u662F\u628A\u836F\u6750\u78BE\u788E\u3002\u8FD9\u4E00\u6363\u4E00\u6775\u4E4B\u95F4\uFF0C\u529B\u9053\u8F7B\u91CD\u3001\u8282\u594F\u7F13\u6025\uFF0C\u90FD\u4F1A\u5F71\u54CD\u836F\u6027\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 939ba8ae874633244b43cdcfec290754, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5E08\u5085"
    text: "\u6012\u5219\u6C14\u4E0A\uFF0C\u529B\u9053\u592A\u731B\u53CD\u800C\u52A9\u957F\u809D\u706B\uFF1B\u5FC3\u5E73\u6C14\u548C\u5730\u4E0B\u6775\uFF0C\u836F\u6027\u65B9\u80FD\u6C89\u964D\u5165\u809D\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 939ba8ae874633244b43cdcfec290754, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5E08\u5085"
    text: "\u8BB0\u4F4F\uFF0C\u4F60\u7684\u5FC3\u5883\u4F1A\u901A\u8FC7\u8FD9\u6363\u836F\u7684\u52A8\u4F5C\uFF0C\u4F20\u5230\u75C5\u4EBA\u7684\u836F\u91CC\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 939ba8ae874633244b43cdcfec290754, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5E08\u5085"
    text: "\u9ED8\u6570\u4E09\u79D2\u540E\u5F00\u59CB\u5427\uFF0C\u51DD\u795E\u9759\u6C14\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 939ba8ae874633244b43cdcfec290754, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
