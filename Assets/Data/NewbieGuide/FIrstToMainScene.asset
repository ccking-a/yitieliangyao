  - name: "\u5E08\u5085"
    text: "\u4E3A\u5E08\u8981\u8FDC\u6E38\u91C7\u836F\u6570\u6708\uFF0C\u8FD9\u533B\u9986\u4FBF\u4EA4\u4E88\u4F60\u4E86\u2014\u2014\u8BB0\u4F4F\uFF0C\u884C\u533B\u5982\u6363\u836F\uFF0C\u5FC3\u6B63\u5219\u836F\u7075\u3002"
    voiceClip: {fileID: 0}
    expressionSprite: {fileID: 21300000, guid: 939ba8ae874633244b43cdcfec290754, type: 3}
    typingCharsPerSecond: 30
    autoNextDelay: 3
  - name: "\u5E08\u5085"
    text: "\u4E0D\u8FC7\u8D70\u4E4B\u524D\uFF0C\u4ECA\u65E5\u6700\u540E\u4E00\u6B21\u5E26\u4F60\u719F\u6089\u95EE\u8BCA\u6D41\u7A0B\u3002\u597D\u597D\u770B\u7740\uFF0C\u4EE5\u540E\u5C31\u8981\u9760\u4F60\u81EA\u5DF1\u4E86\u3002"
